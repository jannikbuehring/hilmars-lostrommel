            "program": "hilmars_lostrommel.py",
            "console": "externalTerminal"
        },
        {
            "name": "Python Debugger: Example input (seed 1, no HTML)",
            "type": "debugpy",
            "request": "launch",
            "program": "hilmars_lostrommel.py",
            "console": "externalTerminal",
            "args": [
                "--players", "input/players_example.csv",
                "--draw-input", "input/draw_input_example.csv",
                "--output", "output/output_example.csv",
                "--seed", "1",
                "--no-html"
            ]
        }
    ]
